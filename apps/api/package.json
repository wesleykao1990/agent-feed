{
  "name": "@agent-feed/api",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "test",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "start": "node --experimental-strip-types src/main.ts"
  },
  "dependencies": {
    "@agent-feed/persistence-postgres": "file:../../packages/persistence-postgres",
    "@agent-feed/producer-service": "file:../../packages/producer-service",
    "@agent-feed/rest-adapter": "file:../../packages/adapters/rest"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  }
}

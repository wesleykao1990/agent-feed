{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": true,
    "rootDir": ".",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true
  },
  "include": ["generated/**/*.ts", "src/**/*.ts"],
  "exclude": ["dist", "node_modules", "test"]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-feed.dev/schemas/finding.schema.json",
  "title": "Agent Feed Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "finding_type",
    "title",
    "summary",
    "subjects",
    "effective_time",
    "assessment",
    "evidence_refs",
    "producer_dedupe_key",
    "routing_tags",
    "attributes",
    "security_flags"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "minLength": 3
    },
    "finding_type": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "summary": {
      "type": "string",
      "minLength": 3,
      "maxLength": 5000
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "name"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "effective_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurred_at",
        "effective_from",
        "effective_to"
      ],
      "properties": {
        "occurred_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "novelty",
        "source_authority_claim",
        "evidence_completeness",
        "agent_confidence"
      ],
      "properties": {
        "novelty": {
          "type": "string",
          "enum": [
            "new",
            "known",
            "uncertain"
          ]
        },
        "evidence_completeness": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "lead_only"
          ]
        },
        "agent_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "source_authority_claim": {
          "type": "string",
          "enum": [
            "primary",
            "official_secondary",
            "third_party",
            "unknown"
          ]
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "producer_dedupe_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "routing_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "attributes": {
      "type": "object"
    },
    "security_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}

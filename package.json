{
  "name": "agent-feed-foundation",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate:foundation": "python3 scripts/validate_package.py",
    "checksums:check": "python3 scripts/generate_checksums.py --check",
    "checksums:write": "python3 scripts/generate_checksums.py --write",
    "types:write": "python3 scripts/generate_protocol_types.py --write",
    "types:check": "python3 scripts/generate_protocol_types.py --check",
    "protocol:compatibility": "python3 scripts/check_protocol_compatibility.py",
    "conformance:test": "node --experimental-strip-types --test tests/conformance/*.test.ts",
    "m2:conformance": "node scripts/run_m2_conformance.mjs",
    "m3:architecture": "node scripts/check_m3_architecture.mjs",
    "m3:conformance": "node scripts/run_m3_conformance.mjs",
    "m4:architecture": "node scripts/check_m4_architecture.mjs",
    "m4:conformance": "node scripts/run_m4_conformance.mjs",
    "m5:architecture": "node scripts/check_m5_architecture.mjs",
    "m5a:conformance": "node scripts/run_m5_conformance.mjs --installability-only",
    "m5:conformance": "node scripts/run_m5_conformance.mjs",
    "m6:architecture": "node scripts/check_m6_architecture.mjs",
    "m6:conformance": "node scripts/run_m6_conformance.mjs",
    "m7:architecture": "node scripts/check_m7_architecture.mjs",
    "m7:conformance": "node scripts/run_m7_conformance.mjs",
    "m8:architecture": "node scripts/check_m8_architecture.mjs",
    "m8:conformance": "node scripts/run_m8_conformance.mjs",
    "m9:architecture": "node scripts/check_m9_architecture.mjs",
    "m9:conformance": "node scripts/run_m9_conformance.mjs",
    "m10:architecture": "node scripts/check_m10_architecture.mjs",
    "m10:conformance": "node scripts/run_m10_conformance.mjs",
    "m1:architecture": "node scripts/check_producer_architecture.mjs",
    "m1:ingress": "node scripts/run_m1_ingress_conformance.mjs",
    "schema:artifact": "node scripts/build_schema_artifact.mjs",
    "schema:artifact:test": "node --test tests/schema-artifact/*.test.mjs",
    "schema:artifact:verify": "node scripts/verify_schema_artifact.mjs",
    "prototype:test": "cd prototype && npm test",
    "prototype:demo": "cd prototype && npm run demo"
  }
}
